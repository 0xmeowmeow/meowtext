AddType application/wasm .wasm
AddType text/javascript .mjs
AddType image/apng .apng
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/javascript application/wasm application/json
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|app\.js|worker\.js|runtime\.zip|style\.css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
